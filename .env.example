# Wolven Hunt STEP-08 environment template.
# Copy to .env locally. Never commit real API keys.

WH_LLM_PROVIDER=mock
WH_LLM_API_KEY=
WH_LLM_BASE_URL=
WH_LLM_MODEL=mock/deterministic
WH_LLM_TIMEOUT_SECONDS=30
WH_LLM_MAX_RETRIES=2
WH_LLM_BUDGET_PER_GAME=100000
WH_LLM_PROVIDER_MAP=

WH_PACING_PROFILE=live
WH_PACING_PHASE_MS=600
WH_PACING_SPEECH_MS=400
WH_PACING_NIGHT_MS=1000
WH_PACING_ACK_TIMEOUT_MS=15000

WH_RUNS_DIR=runs
WH_API_HOST=127.0.0.1
WH_API_PORT=7002
WH_API_CORS_ORIGINS=http://localhost:7001
WH_SERVE_STATIC=false

# Frontend API base URL. Leave empty for same-origin Vite proxy/prod static mode.
# Set only when bypassing the proxy, for example: VITE_WH_API_BASE=http://localhost:7002
VITE_WH_API_BASE=
