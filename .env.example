# Wolven Hunt environment template
# Copy to .env locally when real providers are introduced.

WOLVEN_HUNT_ENV=development
WOLVEN_HUNT_LOG_LEVEL=INFO

# LiteLLM / provider settings, reserved for P2.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LITELLM_MODEL=

# Replay and storage paths, reserved for implementation.
WOLVEN_HUNT_STORAGE_DIR=.wolven_hunt_storage
WOLVEN_HUNT_DEFAULT_SEED=classic-8-dev-seed
